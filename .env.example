# RedShip 环境变量示例（复制为 .env 后修改）
# ===================================================================
# DashScope（全部 AI：embedding / rerank / chat / responses / files）
# ===================================================================
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 官方 SDK：dashscope.base_http_api_url（Generation / Embedding / TextReRank）
DASHSCOPE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
# 工作空间示例：
# DASHSCOPE_HTTP_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# 以下仅用于 SDK 未覆盖的 HTTP：Responses、Files(file-extract)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_FILES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Rerank 已走官方 TextReRank；此变量可留空（兼容旧配置）
# DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_MODEL=qwen3-rerank
CHAT_MODEL=qwen3.5-flash
RESEARCH_MODEL=qwen3.5-plus

# ===================================================================
# 检索 & 研究
# ===================================================================
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RESEARCH_MAX_ITERATIONS=6
RESEARCH_PARALLEL_SUBQUERIES=4
RESEARCH_PER_SUBQUERY_EXTRACTS=3
# RAG：本地命中充足则跳过联网；联网后抽取 Top-K 网页正文
RAG_KB_MIN_HITS=3
RAG_KB_SCORE_FLOOR=0.35
RAG_WEB_EXTRACT_TOP_K=3

# ===================================================================
# 文档智能
# ===================================================================
FILES_API_INLINE_MAX_TOKENS=100000
FILES_API_INLINE_MAX_BYTES=8000000
SESSION_DOC_CHUNK_PREFIX=session_
SESSION_IMAGE_MAX_BYTES=10000000
SESSION_MIN_EXTRACT_CHARS=200

# 数据层 compose 设为 true：bibliography/ 仅扫描 .md / .markdown
# BIBLIOGRAPHY_MARKDOWN_ONLY=false

# MinerU（主 compose / mineru compose；data 镜像不含 MinerU）
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=600
MINERU_OCR=true
# 图片 OCR/描述：MultiModalConversation（与工作空间 base_http_api_url 一致）
VISION_MODEL=qwen3.5-flash

# ===================================================================
# 记忆
# ===================================================================
SESSION_HISTORY_WINDOW=8
SESSION_SUMMARY_TRIGGER=12
# SESSION_SUMMARY_MODEL=qwen3.5-flash
USER_MEMORY_ENABLED=true
USER_MEMORY_TOP_K=5

# ===================================================================
# 基础设施
# ===================================================================
POSTGRES_USER=redship
POSTGRES_PASSWORD=redship
POSTGRES_DB=redship
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://redship:redship@postgres:5432/redship
DATABASE_URL_SYNC=postgresql+psycopg://redship:redship@postgres:5432/redship

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_KB_COLLECTION=knowledge_base
MILVUS_SESSION_COLLECTION=session_chunks
MILVUS_USER_MEMORY_COLLECTION=user_memory

# ===================================================================
# 安全（切勿把真实 .env 提交到 Git；本地备份见 .local/secrets-backup/）
# ===================================================================
# 至少 32 字符随机串。启动时会拒绝下方占位值（除非 ALLOW_INSECURE_DEFAULTS=true）
JWT_SECRET=replace-with-openssl-rand-hex-32-or-longer
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_EMAIL=admin@redship.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# 启动时用上述密码覆盖已存在 bootstrap 管理员的哈希（轮换后立即生效）
ADMIN_BOOTSTRAP_SYNC_PASSWORD=true
# 仅本地排障；可访问环境务必保持 false
ALLOW_INSECURE_DEFAULTS=false

# ===================================================================
# 路径
# ===================================================================
BIBLIOGRAPHY_DIR=/bibliography
UPLOAD_DIR=/app/data/uploads

# ===================================================================
# 前端 / CORS
# ===================================================================
# 留空：浏览器走同源 /api，由 Next rewrites 代理到 backend（适合只穿透 8006 / ngrok）
# 本地直连后端时可设为 http://localhost:8005
NEXT_PUBLIC_API_BASE_URL=
FRONTEND_PORT=8006
BACKEND_PORT=8005
CORS_ORIGINS=*
LOG_LEVEL=INFO
