# RedShip 环境变量示例（复制为 .env 后修改）
# ===================================================================
# DashScope（全部 AI：embedding / rerank / chat / responses / files）
# ===================================================================
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RESPONSES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_FILES_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_MODEL=qwen3-rerank
CHAT_MODEL=qwen3.6-plus
RESEARCH_MODEL=qwen3.6-plus

# ===================================================================
# 检索 & 研究
# ===================================================================
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RESEARCH_MAX_ITERATIONS=6
RESEARCH_PARALLEL_SUBQUERIES=4
RESEARCH_PER_SUBQUERY_EXTRACTS=3

# ===================================================================
# 文档智能
# ===================================================================
FILES_API_INLINE_MAX_TOKENS=100000
FILES_API_INLINE_MAX_BYTES=8000000
SESSION_DOC_CHUNK_PREFIX=session_

# 数据层 compose 设为 true：bibliography/ 仅扫描 .md / .markdown
# BIBLIOGRAPHY_MARKDOWN_ONLY=false

# MinerU（主 compose / mineru compose；data 镜像不含 MinerU）
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=600

# ===================================================================
# 基础设施
# ===================================================================
POSTGRES_USER=redship
POSTGRES_PASSWORD=redship
POSTGRES_DB=redship
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://redship:redship@postgres:5432/redship
DATABASE_URL_SYNC=postgresql+psycopg://redship:redship@postgres:5432/redship

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_KB_COLLECTION=knowledge_base
MILVUS_SESSION_COLLECTION=session_chunks

# ===================================================================
# 安全
# ===================================================================
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_EMAIL=admin@redship.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!2026

# ===================================================================
# 路径
# ===================================================================
BIBLIOGRAPHY_DIR=/bibliography
UPLOAD_DIR=/app/data/uploads

# ===================================================================
# 前端 / CORS
# ===================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8005
FRONTEND_PORT=8006
BACKEND_PORT=8005
CORS_ORIGINS=*
LOG_LEVEL=INFO
